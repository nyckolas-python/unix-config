{
    "python.defaultInterpreterPath": "C:\\Users\\ATLUSER\\AppData\\Local\\Programs\\Python\\Python310\\python.exe",
    "workbench.colorTheme": "Sublime Material Theme - Dark",
    "files.autoSaveDelay": 5000,
    "python.formatting.provider": "none",
    "editor.fontFamily": "CaskaydiaCove NF, JetBrains Mono",
    "editor.fontLigatures": true,
    "editor.inlayHints.fontFamily": "CaskaydiaCove NF",
    "notebook.outputFontFamily": "CaskaydiaCove NF, JetBrains Mono",
    "workbench.iconTheme": "material-icon-theme",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "projectManager.git.baseFolders": [
        "https://github.com/nyckolas-python"
    ],
    "kite.showWelcomeNotificationOnStartup": false,
    "editor.smoothScrolling": true,
    "editor.fontSize": 16,
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "tests",
        "-p",
        "*test*.py"
    ],
    "settingsSync.ignoredSettings": [
        "python.testing.unittestEnabled"
    ],
    "editor.minimap.enabled": false,
    "tabnine.experimentalAutoImports": true,
    "vscode-edge-devtools.webhint": false,
    "window.commandCenter": true,
    "cSpell.userWords": [
        "clockout",
        "datetime",
        "REFERER"
    ],
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash"
        },
        "Ubuntu (WSL)": {
            "path": "C:\\Windows\\System32\\wsl.exe",
            "args": [
                "-d",
                "Ubuntu"
            ]
        },
        "Windows PowerShell": {
            "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        }
    },
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "security.workspace.trust.untrustedFiles": "open",
    "files.autoSave": "afterDelay",
    "search.useGlobalIgnoreFiles": true,
    "editor.accessibilitySupport": "off",
    "workbench.editor.enablePreview": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "git.ignoreRebaseWarning": true,
    "remote.SSH.remotePlatform": {
        "remote-dev": "linux",
        "ec2-3-95-218-243.compute-1.amazonaws.com": "linux"
    },
    "beautify.config": "",
    "beautify.language": {
        "js": {
            "type": [
                "javascript",
                "json",
                "jsonc"
            ],
            "filename": [
                ".jshintrc",
                ".jsbeautifyrc"
            ]
        },
        "css": [
            "css",
            "less",
            "scss"
        ],
        "html": [
            "htm",
            "html"
        ]
    },
    "workbench.startupEditor": "none",
    "explorer.confirmDelete": false,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.fontSize": 16,
    "debug.console.fontSize": 15,
    "editor.fontWeight": "normal",
    "application.shellEnvironmentResolutionTimeout": 20,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.fontFamily": "CaskaydiaCove NF, JetBrains Mono",
    "terminal.integrated.fontWeightBold": "bold",
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    "github.gitProtocol": "ssh",
    "remote.autoForwardPortsSource": "hybrid",
    "projects.autoDetect": "on",
    "projects.useWsl": true,
    "codeium.enableConfig": {
        "*": true,
        "django-html": true
    },
    "editor.indentSize": "tabSize",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "diffEditor.ignoreTrimWhitespace": true
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "prettier.tabWidth": 4,
    "prettier.useTabs": false,
    "scm.workingSets.enabled": true,
    "debug.showVariableTypes": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "makefile.configureOnOpen": false,
    "gitlens.blame.format": "${message|35?} ${author|15?} ${agoOrDate|14-}",
    "diffEditor.maxComputationTime": 0,
    "python.languageServer": "Pylance",
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "gitlens.views.contributors.showAllBranches": true,
    "cursor.general.disableHttp2": true,
    "extensions.ignoreRecommendations": true
}